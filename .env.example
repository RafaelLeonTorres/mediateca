# Configuración de Docker Compose. Copia este archivo como .env (setup.ps1 lo hace solo y genera
# la contraseña). .env no se sube a git.

# Contraseña de PostgreSQL. Usa solo letras, números y guiones. Se fija la primera vez que se crea
# la base: para cambiarla después hay que borrarla con `docker compose down -v`.
POSTGRES_PASSWORD=cambia-esta-clave

# Puertos en tu equipo. La app se abre en http://localhost:WEB_PORT. La API y PostgreSQL solo
# aceptan conexiones de este equipo (para `npm start`, herramientas de base de datos y pruebas).
WEB_PORT=8080
API_PORT=5080
DB_PORT=5433

# Carpeta con tu música y tus videos. Dentro de los contenedores es /media, de solo lectura.
# Ejemplo en Windows: MEDIA_PATH=D:/Media
MEDIA_PATH=./media

# Production por defecto. Con Development, la API publica su documentación en
# http://localhost:API_PORT/scalar.
API_ENVIRONMENT=Production

# Metadatos (fase 4): clave de https://www.omdbapi.com/apikey.aspx y cliente registrado en AniDB.
OMDB_API_KEY=
ANIDB_CLIENT=
ANIDB_CLIENT_VERSION=1
