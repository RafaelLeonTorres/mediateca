# Configuración de Docker Compose. Copia este archivo como .env (setup.ps1 lo hace solo y genera
# la contraseña). .env no se sube a git.

# Contraseña de PostgreSQL. Usa solo letras, números y guiones. Se fija la primera vez que se crea
# la base: para cambiarla después hay que borrarla con `docker compose down -v`.
POSTGRES_PASSWORD=cambia-esta-clave

# Puertos en tu equipo. La app se abre en http://localhost:WEB_PORT. La API y PostgreSQL solo
# aceptan conexiones de este equipo (para `npm start`, herramientas de base de datos y pruebas).
WEB_PORT=8080
API_PORT=5080
DB_PORT=5433

# Opcional. No hace falta para empezar: setup.ps1 monta tus discos de solo lectura y las carpetas de las
# bibliotecas se eligen desde la app (Administrar > Bibliotecas). Úsala solo si quieres una carpeta extra
# (por ejemplo, un NAS): dentro de los contenedores es /media, de solo lectura, y aparece en el selector
# como "Carpeta de medios". Si la carpeta no existe, Docker no arranca la API: déjala en ./media.
# Ejemplo en Windows: MEDIA_PATH=D:/Media
MEDIA_PATH=./media

# Escaneo automático de las bibliotecas, que hace el contenedor "worker". Es una expresión cron de
# Quartz, con segundos: "segundo minuto hora día-del-mes mes día-de-la-semana" (? significa "sin
# valor" en uno de los dos días). Ejemplos: "0 0 3 * * ?" todos los días a las 3:00 y "0 0 3 ? * SUN"
# los domingos a las 3:00. Solo es el valor inicial: después se cambia desde Administrar > Bibliotecas.
SCAN_CRON="0 0 3 * * ?"

# Zona horaria de esos horarios (nombre de la base de datos tz; por ejemplo, America/Mexico_City).
TZ=America/Mexico_City

# Production por defecto. Con Development, la API publica su documentación en
# http://localhost:API_PORT/scalar.
API_ENVIRONMENT=Production

# Metadatos (fase 4): clave de https://www.omdbapi.com/apikey.aspx y cliente registrado en AniDB.
OMDB_API_KEY=
ANIDB_CLIENT=
ANIDB_CLIENT_VERSION=1
