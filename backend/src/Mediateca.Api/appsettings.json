{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "LoginRateLimit": {
      "PermitLimit": 5,
      "Window": "00:01:00"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=mediateca;Username=mediateca"
  },
  "Storage": {
    "DataPath": "data",
    "MediaRoots": [ "/media" ],
    "DrivesPath": "/discos"
  },
  "Media": {
    "Ffprobe": "ffprobe",
    "Ffmpeg": "ffmpeg"
  },
  "Metadata": {
    "Omdb": {
      "ApiKey": ""
    },
    "AniList": {
      "Endpoint": "https://graphql.anilist.co",
      "RequestInterval": "00:00:02"
    }
  }
}
