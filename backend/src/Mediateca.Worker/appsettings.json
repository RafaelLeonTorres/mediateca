{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5433;Database=mediateca;Username=mediateca"
  },
  "Storage": {
    "DataPath": "data",
    "MediaRoots": [ "/media" ]
  },
  "Scanning": {
    "DefaultCron": "0 0 3 * * ?",
    "DefaultEnabled": true,
    "QueuePollInterval": "00:00:03",
    "ScheduleSyncInterval": "00:00:30",
    "MinimumInterval": "00:05:00"
  }
}
