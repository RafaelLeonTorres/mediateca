    "MinimumInterval": "00:05:00"
  },
  "Metadata": {
    "Omdb": {
      "ApiKey": ""
    },
    "AniList": {
      "Endpoint": "https://graphql.anilist.co",
      "RequestInterval": "00:00:02"
    },
    "QueuePollInterval": "00:00:05",
    "AiringRefreshInterval": "1.00:00:00",
    "RefreshCheckInterval": "01:00:00"
  }
}
